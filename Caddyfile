# =============================================================================
# Caddyfile for Kaka Malem - Custom Domain SSL (On-Demand TLS)
# =============================================================================
# Location: /etc/caddy/Caddyfile  (or alongside docker-compose.yml)
# After changes: sudo systemctl reload caddy
#
# This Caddyfile handles custom domain traffic with automatic SSL via Let's Encrypt.
# Nginx continues to handle the main kakamalem.com domain (port 8444 internally).
# Caddy listens on port 8443 for custom domain HTTPS.
#
# Architecture (TLS passthrough via Nginx stream module):
#   Custom domain → DNS (A record → server IP) → Nginx stream :443
#     → ssl_preread SNI routing → Caddy :8443 (TLS passthrough, no termination)
#     → Caddy provisions SSL via Let's Encrypt, proxies to Next.js app
#
#   kakamalem.com → Nginx stream :443 → Nginx internal :8444 (SSL termination)
#
# See database/nginx-tls-passthrough.conf for the stream module config.
# See database/nginx-custom-domains.conf for ACME challenge proxy.
# =============================================================================

{
	# On-demand TLS: Caddy asks our app before issuing a certificate
	on_demand_tls {
		ask http://127.0.0.1:3000/api/caddy/ask
		interval 5m
		burst 5
	}

	# Listen on non-standard ports (Nginx occupies 80/443)
	# Caddy uses 8443 for HTTPS and 8080 for HTTP (ACME challenges)
	https_port 8443
	http_port 8080

	# Disable automatic HTTP->HTTPS redirects (Nginx handles port 80)
	auto_https disable_redirects

	# Email for Let's Encrypt account (recommended, fixes ZeroSSL issues)
	email admin@kakamalem.com
}

# Handle all custom domains
:8443 {
	tls {
		on_demand
	}

	# Proxy to the Next.js application (both blue/green for zero-downtime deploys)
	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy first
		fail_duration 10s
		health_uri /api/health
		health_interval 10s
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Serve uploaded files directly (bypasses Node.js)
	handle_path /uploads/* {
		root * /var/www/kakamalem-uploads
		file_server {
			hide .php .jsp .asp .aspx .cgi .pl .py .sh .bash
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Request size limit (for uploads)
	request_body {
		max_size 20MB
	}

	log {
		output file /var/log/caddy/custom-domains.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}


# =============================================================================
# OPTION B: Full Caddy (replace Nginx entirely)
# =============================================================================
