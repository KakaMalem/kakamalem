# =============================================================================
# Caddyfile for Kaka Malem - Custom Domain SSL (On-Demand TLS)
# =============================================================================
# Location: /etc/caddy/Caddyfile  (or alongside docker-compose.yml)
# After changes: sudo systemctl reload caddy
#
# This Caddyfile handles custom domain traffic with automatic SSL via Let's Encrypt.
# Nginx continues to handle the main kakamalem.com domain (ports 80/443).
# Caddy listens on port 8443 for custom domain HTTPS, with Nginx proxying to it.
#
# Architecture:
#   Custom domain → DNS (CNAME proxy.kakamalem.com) → Nginx :443
#     → Nginx catch-all server block → proxy to Caddy :8443
#     → Caddy provisions SSL, proxies to Next.js app
#
# Alternative (simpler): Replace Nginx with Caddy entirely.
# See the "Full Caddy" section below for that approach.
# =============================================================================

# =============================================================================
# OPTION A: Caddy behind Nginx (recommended if keeping existing Nginx setup)
# =============================================================================
# Caddy handles only custom domains on an internal HTTPS port.
# Add a catch-all server block in Nginx to proxy unknown hosts to Caddy.
#
# Nginx catch-all addition (/etc/nginx/sites-available/kakamalem-custom):
#
#   server {
#       listen 443 ssl default_server;
#       listen [::]:443 ssl default_server;
#
#       # Self-signed fallback cert (Caddy handles the real certs)
#       ssl_certificate /etc/nginx/ssl/fallback.pem;
#       ssl_certificate_key /etc/nginx/ssl/fallback-key.pem;
#
#       location / {
#           proxy_pass https://127.0.0.1:8443;
#           proxy_ssl_server_name on;
#           proxy_ssl_name $host;
#           proxy_set_header Host $host;
#           proxy_set_header X-Real-IP $remote_addr;
#           proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#           proxy_set_header X-Forwarded-Proto https;
#       }
#   }
# =============================================================================

{
	# On-demand TLS: Caddy asks our app before issuing a certificate
	on_demand_tls {
		ask http://127.0.0.1:3000/api/caddy/ask
		interval 5m
		burst 5
	}

	# Listen on non-standard HTTPS port (Nginx is on 443)
	# Remove this line if using Caddy as the sole reverse proxy
	https_port 8443

	# Disable HTTP port (Nginx handles port 80)
	http_port 0
}

# Handle all custom domains
:8443 {
	tls {
		on_demand
	}

	# Proxy to the Next.js application
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Serve uploaded files directly (bypasses Node.js)
	handle_path /uploads/* {
		root * /var/www/kakamalem-uploads
		file_server {
			hide .php .jsp .asp .aspx .cgi .pl .py .sh .bash
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Request size limit (for uploads)
	request_body {
		max_size 20MB
	}

	log {
		output file /var/log/caddy/custom-domains.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}


# =============================================================================
# OPTION B: Full Caddy (replace Nginx entirely)
# =============================================================================
# Uncomment this section and remove Option A if you want Caddy to handle
# everything (main domain + custom domains).
