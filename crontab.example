# =============================================================================
# Kaka Malem Cron Jobs
# =============================================================================
# Install: crontab -e  (paste these lines)
# View:    crontab -l
#
# Replace YOUR_CRON_SECRET with the value from .env
# =============================================================================

# Database backup - daily at 3 AM (with cleanup of backups older than 14 days)
0 3 * * * /var/www/kakamalem/scripts/backup-database.sh --cleanup >> /var/log/kakamalem-backup.log 2>&1

# Domain health check - every 5 minutes (auto-verify pending custom domains)
*/5 * * * * curl -s -H "Authorization: Bearer YOUR_CRON_SECRET" https://kakamalem.com/api/cron/domain-health > /dev/null 2>&1

# Temp upload cleanup - daily at 4 AM
0 4 * * * find /tmp/kakamalem-uploads -type f -mmin +60 -delete 2>/dev/null
