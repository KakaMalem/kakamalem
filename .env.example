# =============================================================================
# KAKA MALEM ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
#
# Stack: Next.js 16 + Better Auth + PostgreSQL 18 + PgBouncer + Local NVMe
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL 18 + PgBouncer)
# =============================================================================
# VPS Optimized: 2 dedicated + 2 shared cores, 16GB RAM, 75GB NVMe
# PostgreSQL configured with io_uring async I/O and NVMe optimization

# Application connection - uses PgBouncer for connection pooling (port 6543)
# PgBouncer runs in transaction mode for optimal connection reuse
DATABASE_URL="postgresql://kakamalem_app:your_password@localhost:6543/kakamalem"

# Migration connection - direct to PostgreSQL (port 5432)
# Used by Drizzle for migrations only (bypasses PgBouncer)
DATABASE_URL_UNPOOLED="postgresql://kakamalem_migrations:your_password@localhost:5432/kakamalem"

# Optional: Read-only connection for analytics dashboards
# DATABASE_READONLY_URL="postgresql://kakamalem_readonly:your_password@localhost:6543/kakamalem"

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================
# Better Auth - self-hosted, PostgreSQL-backed
# Docs: https://www.better-auth.com

# Secret for signing tokens/cookies (REQUIRED)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"

# App URL for auth redirects and callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# OAUTH PROVIDERS (Optional)
# =============================================================================
# Configure in Google Cloud Console / Facebook Developer Portal
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/{provider}

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth (common in Afghan market)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# =============================================================================
# EMAIL SERVICE (SMTP / Nodemailer)
# =============================================================================
# For email verification, password resets, order notifications
# Using SMTP with Nodemailer - works with Gmail, Mailgun, SendGrid, etc.

# SMTP server configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# From address for outgoing emails
SMTP_FROM_NAME="Kaka Malem"
SMTP_FROM_EMAIL="your-email@gmail.com"

# Note: For Gmail, use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords

# =============================================================================
# FILE STORAGE (Local NVMe)
# =============================================================================
# Using local NVMe storage for maximum performance
# Files served via Next.js API route at /uploads/*
# Sharp handles image optimization (resize, thumbnails, WebP conversion)

# Local storage directory (absolute path on VPS)
# IMPORTANT: Use a path OUTSIDE the project to survive deploys!
# Development: Use a local folder outside the project
# Production: /var/www/kakamalem-uploads (NOT inside /var/www/kakamalem/)
STORAGE_PATH="/var/www/kakamalem-uploads"

# Temp directory for upload processing (formidable streams here)
# Files are processed and moved to STORAGE_PATH, then deleted from temp
UPLOAD_TEMP_PATH="/tmp/kakamalem-uploads"

# Public URL for uploaded files
# Development: "/uploads" (served by Next.js API route)
# Production with CDN: "https://cdn.kakamalem.com/uploads"
NEXT_PUBLIC_UPLOADS_URL="/uploads"

# Maximum upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="development"
# NODE_ENV="production"

# Site URL (used for emails, SEO, Open Graph)
NEXT_PUBLIC_SITE_URL="https://kakamalem.com"

# App domain (for multi-tenant routing)
NEXT_PUBLIC_APP_DOMAIN="kakamalem.com"

# Default currency for new stores
DEFAULT_CURRENCY="AFN"

# =============================================================================
# OFFLINE POS (Progressive Web App)
# =============================================================================
# Feature flag for offline POS functionality (Phase 1 of Offline Sync)
# When enabled: PWA install prompt, connectivity indicator, local IndexedDB
# When disabled: POS works in online-only mode (default behavior)
# See docs/OFFLINE_SYNC_ROADMAP.md for full implementation details
NEXT_PUBLIC_OFFLINE_POS="false"

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================
# These are set automatically by the deployment script

# PM2 process name
# PM2_APP_NAME="kakamalem"

# Node.js production optimizations
# NODE_OPTIONS="--max-old-space-size=4096"

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# For local development without VPS

# Local PostgreSQL (no PgBouncer needed)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kakamalem"
# DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/kakamalem"

# Local storage path (Windows example)
# STORAGE_PATH="C:/Users/YourName/kakamalem-uploads"

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# In-app notifications are stored in PostgreSQL (notifications table).
# Uses database polling with React Query + Web Push for device notifications.

# Web Push (VAPID) — Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact email for push services (mailto: or https: URL)
VAPID_SUBJECT="mailto:kakamalem.team@gmail.com"

# =============================================================================
# CUSTOM DOMAINS (Dokploy + Traefik + Let's Encrypt)
# =============================================================================
# Tenants connect a custom domain via the dashboard. After DNS verifies,
# the app registers the hostname with Dokploy via its API; Dokploy then
# updates Traefik's routing and provisions a Let's Encrypt certificate.

# CNAME target that custom domains should point to (for subdomains)
DOMAIN_PROXY_TARGET="proxy.kakamalem.com"

# Server IP address for apex/root domains (A record target)
# Apex domains (e.g., mybrand.com) can't use CNAME, so they need an A record
SERVER_IP=""

# --- Dokploy API (domain provisioning) ---
# Which provisioner to use: "dokploy" in production, "null" in local dev.
DOMAIN_PROVISIONER="null"

# Base URL of your Dokploy instance. In production use the in-cluster
# Docker service name + internal port (e.g. "http://dokploy:3000"), NOT
# the public hostname. Public hostnames hit hairpin-NAT and the request
# silently fails from inside the container.
DOKPLOY_API_URL=""

# API key from Dokploy: Settings → Profile → API/CLI. Sent as x-api-key.
DOKPLOY_API_KEY=""

# Application ID that custom domains should be attached to (the kakamalem
# web app). Find it in the Dokploy dashboard URL when viewing the app.
DOKPLOY_APPLICATION_ID=""

# =============================================================================
# CRON JOBS
# =============================================================================
# Secret for authenticating cron job requests (e.g., domain health check)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-at-least-32-characters"

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================

# HesabPay - Afghanistan's primary digital payment solution
# Get your API key from: https://developers.hesab.com
#
# The same API key is used for:
# - Creating payment sessions
# - Verifying payments
# - Webhook signature verification (via HesabPay's verify-signature API)
#
# Escrow Model: All payments go to platform's HesabPay account.
# The platform holds funds and pays out to sellers after fulfillment.
#
# Webhook URL to register: https://kakamalem.com/api/webhooks/hesabpay
HESABPAY_API_KEY="your-hesabpay-api-key"
